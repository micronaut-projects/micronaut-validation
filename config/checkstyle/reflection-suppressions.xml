<?xml version="1.0"?>

<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!-- The suppressions of reflection.xml: the reflection module reads the classes, that is what it is for.
     The files allowed to import java.lang.reflect are not listed here but in reflection-import-control.xml. -->
<suppressions>
    <suppress checks="RegexpSinglelineJava" files="[\\/]validation-reflection[\\/]"/>
</suppressions>
