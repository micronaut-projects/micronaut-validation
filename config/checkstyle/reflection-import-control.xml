<?xml version="1.0"?>

<!DOCTYPE import-control PUBLIC
  "-//Checkstyle//DTD ImportControl Configuration 1.4//EN"
  "https://checkstyle.org/dtds/import_control_1_4.dtd">

<!--
  Which files may import java.lang.reflect, and which package may import io.micronaut.reflection: rule 1 of
  reflection.xml, which explains the three rules and why they live outside checkstyle.xml.

  A constraint, a bean and an executable are described through the metadata the annotation processors generate,
  and through micronaut-validation-reflection where the processors never saw the type. What is left is the
  reflection the specification API imposes: Jakarta Validation names an executable by its java.lang.reflect.Method
  and its parameters by a Parameter, resolves a value extractor over a Type, and hands back an Annotation, so the
  files that meet the API at its edge read those types and no others should.

  Each file below is named on purpose. Adding one is a decision to make deliberately, not one to make by writing
  an import; the file to change first is usually not this one.
-->
<import-control pkg="io.micronaut.validation" strategyOnMismatch="allowed">

    <!-- denied everywhere, and allowed back below for the files that meet the specification API -->
    <disallow pkg="java.lang.reflect"/>
    <!-- the reflection module of micronaut-core is read by micronaut-validation-reflection only: an
         application adding micronaut-validation alone runs on the compile-time introspections -->
    <disallow pkg="io.micronaut.reflection"/>
    <!-- deprecated for removal in core; GenericArguments resolves a generic signature in its place -->
    <disallow class="io.micronaut.core.reflect.GenericTypeUtils"/>

    <!-- the interceptor is handed the method the framework is invoking -->
    <file name="ValidatingInterceptor">
        <allow pkg="java.lang.reflect"/>
    </file>

    <subpackage name="validator">
        <!-- the executable an API names by its Method or Constructor, resolved to the best metadata there is;
             the seam the reflection module implements, and the generated-metadata answer behind it -->
        <file name="ReflectionSupport">
            <allow pkg="java.lang.reflect"/>
        </file>
        <file name="CompileTimeSupport">
            <allow pkg="java.lang.reflect"/>
        </file>
        <file name="IntrospectedExecutable">
            <allow pkg="java.lang.reflect"/>
        </file>
        <!-- the structure of a generic signature the API hands over as a Type -->
        <file name="GenericArguments">
            <allow pkg="java.lang.reflect"/>
        </file>
        <file name="ExecutableMethodValidator">
            <allow pkg="java.lang.reflect"/>
        </file>
        <file name="DefaultValidator">
            <allow pkg="java.lang.reflect"/>
        </file>
        <file name="ValidationPath">
            <allow pkg="java.lang.reflect"/>
        </file>
        <!-- the parameter names an API asks for by Executable -->
        <file name="DefaultParameterNameProvider">
            <allow pkg="java.lang.reflect"/>
        </file>
        <!-- the java.lang.reflect.Type a value extractor is resolved over -->
        <file name="DefaultValidatorConfiguration">
            <allow pkg="java.lang.reflect"/>
        </file>
        <file name="ContainerTypeArguments">
            <allow pkg="java.lang.reflect"/>
        </file>

        <subpackage name="constraints">
            <file name="ConstraintDefinitions">
                <allow pkg="java.lang.reflect"/>
            </file>
            <!-- the runtime counterpart of the processor extensions, which reads the annotation type -->
            <file name="ConstraintAnnotationCustomizer">
                <allow pkg="java.lang.reflect"/>
            </file>
            <!-- instantiating a validator the container does not build -->
            <file name="DefaultInternalConstraintValidatorFactory">
                <allow pkg="java.lang.reflect"/>
            </file>
            <!-- java.lang.reflect.Array, to read an array of any component type -->
            <file name="UniqueElementsValidator">
                <allow pkg="java.lang.reflect"/>
            </file>
        </subpackage>
    </subpackage>

    <!-- the reflection module: reading the classes is what it is for -->
    <subpackage name="reflection">
        <allow pkg="java.lang.reflect"/>
        <allow pkg="io.micronaut.reflection"/>
    </subpackage>

    <subpackage name="xml">
        <file name="XmlValidationMetadataProvider">
            <allow pkg="java.lang.reflect"/>
        </file>
        <!-- the field or the getter a mapping names, read for the value and for the generic signature it
             declares, where the archive holds no introspection to read them from -->
        <file name="XmlBeanIntrospection">
            <allow pkg="java.lang.reflect"/>
        </file>
    </subpackage>

</import-control>
