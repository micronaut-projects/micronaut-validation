<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >

<suite name="Jakarta-Bean-Validation-TCK" verbose="1">
    <!--
        Generated descriptions, with micronaut.validation.reflection.enabled=false.
        The complete 1,054-test audit passes every former exclusion except the constructor
        descriptor of a non-static inner class. Core's generated constructor metadata does
        not include its implicit enclosing-instance parameter. The optional reflection stack
        passes this case. The restricted suite therefore runs 1,053 tests with one measured
        exclusion; excluded tests are not reported as skipped.

        Reassess with -PtckIntrospectionSuite=tck-spec-tests.xml before removing this exclusion.
    -->
    <test name="Jakarta-Bean-Validation-TCK">
        <packages>
            <package name="org.hibernate.beanvalidation.tck.tests.*"/>
        </packages>
        <classes>
            <class name="org.hibernate.beanvalidation.tck.tests.metadata.ExecutableDescriptorTest">
                <methods>
                    <exclude name="testGetParameterDescriptorsForConstructorOfInnerClass"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
