<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >

<suite name="Jakarta-Bean-Validation-TCK Methods" verbose="1">
    <test name="Jakarta-Bean-Validation-TCK Methods">

        <classes>

            <!-- Lean core method-validation coverage. Full method-validation compliance is covered by jakartaTck. -->
            <class name="org.hibernate.beanvalidation.tck.tests.methodvalidation.MethodValidationTest">
                <methods>
                    <include name="methodReturnValueValidationPerformsGroupConversion"/>
                </methods>
            </class>

        </classes>

    </test>
</suite>
